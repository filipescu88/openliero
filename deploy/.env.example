# Copied to deploy/.env by deploy.sh on its first run (or create it by hand).
# deploy/.env holds secrets: it stays on the server and is never committed.

# Domain the game is served on (managed by Cloudflare).
SITE_DOMAIN=liero.pl

# Token of the Cloudflare Tunnel: Zero Trust → Networks → Tunnels → your tunnel
# → "Install connector" → the long string after `--token`.
TUNNEL_TOKEN=

# Local port for checks from the server itself (http://127.0.0.1:8088).
WEB_PORT=8088

# Images to run. Defaults: the ones GitHub Actions publishes.
#RELAY_IMAGE=ghcr.io/filipescu88/openliero/relay-server:latest
#WEB_IMAGE=ghcr.io/filipescu88/openliero/web:latest
